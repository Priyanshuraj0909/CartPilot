APP_NAME=CartPilot
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL: local defaults only. Production must set DATABASE_URL explicitly.
# postgres:// and postgresql:// are normalized to the async driver.
# For managed TLS, use the provider URL (sslmode becomes asyncpg ssl).
POSTGRES_USER=cartpilot
POSTGRES_PASSWORD=cartpilot
POSTGRES_DB=cartpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cartpilot:cartpilot@localhost:5432/cartpilot

# Redis is optional diagnostics only. Set REDIS_URL= to disable it.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Pricing Agent Parameters (Phase 3)
MAX_PRICE_INCREASE_PERCENT=10.0
MAX_PRICE_DECREASE_PERCENT=10.0
PRICING_LOOKBACK_DAYS=14
MIN_MARGIN_PERCENT=0.0
PRICING_ADJUSTMENT_PERCENT=5.0

# Frontend: public BUILD-TIME settings; rebuild after changing them.
# On HTTPS hosting use https://your-backend.example.com.
# Omitted production URL uses same-origin /api/v1 (requires an API reverse proxy).
VITE_API_URL=http://localhost:8000
# Presentation currency; the current data model has no stored currency metadata.
VITE_CURRENCY=USD

# Restock Agent Parameters (Phase 4)
RESTOCK_LOOKBACK_DAYS=14
DEFAULT_LEAD_TIME_DAYS=5
SAFETY_STOCK_DAYS=2
MAX_REORDER_QUANTITY=500

# Phase 7 Promotion Agent — advisory only; retained gross margin is distinct from pricing markup
PROMOTION_LOOKBACK_DAYS=14
MAX_PROMOTION_DISCOUNT_PERCENT=20
PROMOTION_MIN_MARGIN_PERCENT=10
HIGH_INVENTORY_DAYS_THRESHOLD=45
SLOW_SALES_THRESHOLD=1.5
PROMOTION_ZERO_SALES_MIN_INVENTORY=30
PROMOTION_TREND_CHANGE_PERCENT=20
PROMOTION_MILD_DISCOUNT_PERCENT=5
PROMOTION_MODERATE_DISCOUNT_PERCENT=10
PROMOTION_SEVERE_DISCOUNT_PERCENT=15

# Phase 8 Listing Agent — deterministic quality checks, no automatic publication
MIN_TITLE_LENGTH=10
MAX_TITLE_LENGTH=120
MIN_DESCRIPTION_LENGTH=80
MAX_DESCRIPTION_LENGTH=2000
LISTING_POOR_QUALITY_THRESHOLD=0.6

# Phase 10 priority queue budget (all omitted/critical items remain visible)
MAX_ACTIONS_PER_PLAN=5

# Phase 11 — Shopify READ ONLY. Backend credentials only; never use VITE_ for tokens.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Bind to an existing, preferably dedicated CartPilot merchant ID.

# Optional until configured: uncomment and replace with your merchant ID.
# SHOPIFY_MERCHANT_ID=1
SHOPIFY_TIMEOUT_SECONDS=30
SHOPIFY_MAX_RETRIES=3
SHOPIFY_MAX_PAGES=100
SHOPIFY_READ_COSTS=true

# Keep pooled locally; use null for Vercel Python Functions with Neon.
DATABASE_POOL_MODE=pooled

# Optional local account enforcement; production always enforces accounts.
REQUIRE_AUTH=false
VITE_REQUIRE_AUTH=false
